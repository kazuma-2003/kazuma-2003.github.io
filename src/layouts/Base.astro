---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE_TITLE, SITE_ROMAJI, SITE_DESCRIPTION, AUTHOR, FOUNDED } from '../consts';
import { getGdp, formatUsd } from '../gdp';
import { getPosts, dotDate, plainText } from '../lib';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}
const { title, type = 'website' } = Astro.props;
const description = plainText(Astro.props.description ?? SITE_DESCRIPTION);
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const posts = await getPosts();
const latest = posts[0];
const gdp = await getGdp();
const gdpYears = [...new Set(gdp.rows.map((r) => r.year))].join('・');
const nav = [
  { href: '/', label: '記事', on: path === '/' || path.startsWith('/posts') },
  { href: '/#cats', label: '分類', on: false },
  { href: '/tags/', label: 'タグ', on: path.startsWith('/tags') },
  { href: '/about/', label: 'このブログについて', on: path.startsWith('/about') },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={new URL('/images/og.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1c130b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Dela+Gothic+One&family=JetBrains+Mono:wght@400;600&family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;600&display=swap"
    />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs><path id="seal-ring" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs>
      <symbol id="seal" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="48" fill="#e8772e" stroke="#1c130b" stroke-width="3" />
        <circle cx="50" cy="50" r="29" fill="#f3ead6" stroke="#1c130b" stroke-width="2.5" />
        <text font-family="JetBrains Mono, monospace" font-size="9.2" font-weight="600" letter-spacing="1.6" fill="#1c130b">
          <textPath href="#seal-ring">{SITE_ROMAJI} ✦ EST. {FOUNDED} ✦</textPath>
        </text>
        <text x="50" y="61" text-anchor="middle" font-family="Dela Gothic One, sans-serif" font-size="30" fill="#1c130b">経</text>
      </symbol>
    </svg>

    {latest && (
      <div class="topbar">
        <div class="wrap">
          <span class="stamp">最新号 {dotDate(latest.data.date)}</span>
          <span class="lead"><b>{latest.data.title}</b></span>
          <a class="go" href={`/posts/${latest.id}/`}>読む →</a>
        </div>
      </div>
    )}

    <div class="ticker" title={`名目GDP（米ドル）と実質成長率。出典：${gdp.source}`}>
      <div class="track">
        {[0, 1].map((copy) => (
          <div class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
            <span class="t-label">名目GDP {gdpYears}年 ── 世界銀行</span>
            {gdp.rows.map((r) => (
              <span class="t-item">
                <b>{r.name}</b> {formatUsd(r.gdp)}
                {r.growth !== null && (
                  <em class={r.growth >= 0 ? 'up' : 'down'}>{r.growth >= 0 ? '▲' : '▼'}{Math.abs(r.growth).toFixed(1)}%</em>
                )}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <header class="header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg class="seal" aria-hidden="true"><use href="#seal" /></svg>
          <span><span class="name">{SITE_TITLE}</span><span class="romaji">{SITE_ROMAJI}</span></span>
        </a>
        <nav class="nav">
          {nav.map((n) => <a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
          <a class="admin-gear" id="admin-gear" href="sekaikeizai-admin:open" title="管理画面を開く" aria-label="管理画面を開く" hidden>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M19.14 12.94a7.07 7.07 0 0 0 .06-.94 7.07 7.07 0 0 0-.06-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.03 7.03 0 0 0-1.63-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.59.24-1.13.56-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.65 8.84a.5.5 0 0 0 .12.64l2.03 1.58a7.07 7.07 0 0 0 0 1.88l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32c.13.22.39.3.6.22l2.39-.96c.5.38 1.04.7 1.63.94l.36 2.54c.04.24.25.42.5.42h3.84c.25 0 .46-.18.5-.42l.36-2.54c.59-.24 1.13-.56 1.63-.94l2.39.96c.22.08.47 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z"/></svg>
          </a>
        </nav>
        <a class="btn small rss" href="/rss.xml">RSS<span class="long">で購読</span></a>
      </div>
    </header>

    <slot name="hero" />
    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <a class="brand" href="/">
              <svg class="seal" aria-hidden="true"><use href="#seal" /></svg>
              <span><span class="name">{SITE_TITLE}</span><span class="romaji">{SITE_ROMAJI}</span></span>
            </a>
            <p class="footer-desc">{SITE_DESCRIPTION}</p>
          </div>
          <div>
            <h4>READ</h4>
            <ul><li><a href="/">記事一覧</a></li><li><a href="/#cats">分類</a></li><li><a href="/tags/">タグ</a></li></ul>
          </div>
          <div>
            <h4>ABOUT</h4>
            <ul><li><a href="/about/">このブログについて</a></li><li><a href="/rss.xml">RSS</a></li></ul>
          </div>
        </div>
        <div class="fine"><span>© {new Date().getFullYear()} {SITE_TITLE} ／ {AUTHOR}</span><span>VOL.01 ── PRINTED ON THE WEB</span></div>
      </div>
    </footer>

    <div class="admin-hint" id="admin-hint" role="status" hidden>
      管理画面が開かない場合は、ブログのフォルダの「ブログを書く.bat」をダブルクリックしてください。
    </div>
    <script is:inline>
      // 管理者用の歯車：このブラウザで一度 ?admin=on を開いたときだけ表示する（?admin=off で消える）。
      // 押すと Windows に登録した sekaikeizai-admin: リンク経由で「ブログを書く.bat」が起動する。
      (function () {
        var KEY = 'sekaikeizai-admin';
        var q = new URLSearchParams(location.search).get('admin');
        try {
          if (q === 'on') localStorage.setItem(KEY, '1');
          if (q === 'off') localStorage.removeItem(KEY);
          if (localStorage.getItem(KEY) !== '1') return;
        } catch (e) { return; }
        if (q) {
          var u = new URL(location.href);
          u.searchParams.delete('admin');
          history.replaceState(null, '', u);
        }
        var gear = document.getElementById('admin-gear');
        var hint = document.getElementById('admin-hint');
        gear.hidden = false;
        gear.addEventListener('click', function () {
          // 起動の確認ダイアログが出るとページはフォーカスを失う。出なければ案内を出す。
          var left = false;
          var onBlur = function () { left = true; };
          window.addEventListener('blur', onBlur, { once: true });
          setTimeout(function () {
            window.removeEventListener('blur', onBlur);
            if (!left) { hint.hidden = false; setTimeout(function () { hint.hidden = true; }, 8000); }
          }, 1500);
        });
      })();
    </script>
  </body>
</html>
