---
// トップの大見出しの代わりのイラスト：中央に打ち上がるロケット、左から向かう飛行機、右から腕を伸ばすロボットアーム。
// どの要素も中央（太陽とロケット）に向かう構図。ポスター調：墨の太い輪郭、サフラン・からし色・紺の面、右下にずらした影。
---
<svg class="hero-art" viewBox="0 0 640 440" role="img" aria-labelledby="hero-art-title">
  <title id="hero-art-title">中央で打ち上がるロケットと、左から向かう飛行機、右から腕を伸ばすロボットアームのイラスト</title>
  <defs>
    <!-- 版画風のずらした影 -->
    <filter id="ha-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feFlood flood-color="#1c130b" result="ink" />
      <feComposite in="ink" in2="SourceAlpha" operator="in" result="shape" />
      <feOffset in="shape" dx="5" dy="5" result="drop" />
      <feMerge><feMergeNode in="drop" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <pattern id="ha-hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="10" stroke="#1c130b" stroke-width="2" opacity="0.35" />
    </pattern>
    <!-- 円柱の陰影（左が明るく右が暗い） -->
    <linearGradient id="ha-cyl" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.45" />
      <stop offset="0.25" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="0.7" stop-color="#1c130b" stop-opacity="0" />
      <stop offset="1" stop-color="#1c130b" stop-opacity="0.32" />
    </linearGradient>
  </defs>

  <g stroke="#1c130b" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
    <!-- 中央の太陽と、視線を中央に集める輪 -->
    <circle cx="320" cy="196" r="178" fill="none" stroke-width="3" stroke-dasharray="2 11" opacity="0.45" />
    <circle cx="320" cy="196" r="150" fill="#c79a2b" stroke="none" opacity="0.85" />
    <circle cx="320" cy="196" r="150" fill="url(#ha-hatch)" stroke="none" opacity="0.45" />
    <g fill="#c79a2b" stroke-width="3">
      <path fill="#e8772e" d="M214 58 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5z" />
      <path fill="#e8772e" d="M426 58 l5 12 12 5 -12 5 -5 12 -5 -12 -12 -5 12 -5z" />
      <path d="M170 116 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3z" />
      <path d="M470 116 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3z" />
    </g>

    <!-- 地面 -->
    <line x1="10" y1="412" x2="630" y2="412" stroke-width="5" />
    <rect x="10" y="414" width="620" height="18" fill="url(#ha-hatch)" stroke="none" />

    <!-- 飛行機（左から中央へ） -->
    <path d="M14 256 Q40 222 62 200" fill="none" stroke-dasharray="2 11" stroke-width="5" opacity="0.55" />
    <g filter="url(#ha-shadow)" transform="translate(150 178) rotate(-9) scale(0.78)">
      <path d="M-105 -18 L-128 -70 L-100 -70 L-62 -18 Z" fill="#e8772e" />
      <path d="M-110 0 Q-112 -20 -82 -20 L72 -20 Q112 -20 130 0 Q112 18 72 18 L-82 18 Q-112 18 -110 0 Z" fill="#f3ead6" />
      <path d="M96 -16 Q118 -12 126 -2 L96 -2 Z" fill="#1f3a5f" stroke-width="3" />
      <g fill="#1f3a5f" stroke-width="2.5">
        <circle cx="-56" cy="-4" r="5" /><circle cx="-36" cy="-4" r="5" /><circle cx="-16" cy="-4" r="5" />
        <circle cx="4" cy="-4" r="5" /><circle cx="24" cy="-4" r="5" /><circle cx="44" cy="-4" r="5" /><circle cx="64" cy="-4" r="5" />
      </g>
      <path d="M-8 6 L42 6 L-14 70 L-46 70 Z" fill="#1f3a5f" />
      <rect x="-4" y="26" width="38" height="18" rx="9" fill="#c79a2b" stroke-width="3.5" />
      <path d="M-100 8 L-120 26 L-96 26 L-80 12" fill="#1f3a5f" stroke-width="3.5" />
    </g>

    <!-- ロボットアーム（右から中央へ腕を伸ばす） -->
    <g filter="url(#ha-shadow)">
      <path d="M470 412 L478 382 L584 382 L592 412 Z" fill="#1c130b" />
      <rect x="509" y="356" width="44" height="28" rx="6" fill="#c79a2b" />
      <!-- 墨の太線の上に色の線を重ねて、輪郭付きの部材にする -->
      <line x1="531" y1="356" x2="486" y2="244" stroke-width="40" />
      <line x1="531" y1="356" x2="486" y2="244" stroke="#e8772e" stroke-width="30" />
      <line x1="486" y1="244" x2="404" y2="272" stroke-width="32" />
      <line x1="486" y1="244" x2="404" y2="272" stroke="#f3ead6" stroke-width="22" />
      <line x1="513" y1="306" x2="501" y2="276" stroke-width="3" />
      <line x1="458" y1="252" x2="434" y2="260" stroke-width="3" />
      <circle cx="531" cy="356" r="20" fill="#1f3a5f" />
      <circle cx="531" cy="356" r="7" fill="#f3ead6" stroke-width="3" />
      <circle cx="486" cy="244" r="20" fill="#1f3a5f" />
      <circle cx="486" cy="244" r="7" fill="#f3ead6" stroke-width="3" />
      <circle cx="404" cy="272" r="14" fill="#c79a2b" />
      <!-- つかみ（グリッパー）と歯車 -->
      <path d="M396 282 L382 312 L392 318" fill="none" stroke-width="8" />
      <path d="M412 284 L414 316 L402 320" fill="none" stroke-width="8" />
      <g transform="translate(398 342)">
        <circle r="19" fill="none" stroke-width="10" stroke-dasharray="7 5.3" />
        <circle r="15" fill="#c79a2b" stroke-width="3.5" />
        <circle r="5.5" fill="#f3ead6" stroke-width="3" />
      </g>
    </g>

    <!-- ロケット（中央。H3 を参考にした2段式＋固体ロケットブースター） -->
    <g filter="url(#ha-shadow)">
      <!-- 噴射炎 -->
      <path d="M300 344 C304 378 312 402 320 412 C328 402 336 378 340 344 Z" fill="#c79a2b" />
      <path d="M309 344 C312 368 316 386 320 396 C324 386 328 368 331 344 Z" fill="#fff7e6" stroke-width="3" />
      <path d="M279 342 C281 362 285 376 289 384 C293 376 297 362 299 342 Z" fill="#c79a2b" stroke-width="3" />
      <path d="M341 342 C343 362 347 376 351 384 C355 376 359 362 361 342 Z" fill="#c79a2b" stroke-width="3" />
      <!-- 固体ロケットブースター -->
      <path d="M280 206 C280 194 285 184 289 178 C293 184 298 194 298 206 L298 332 L280 332 Z" fill="#f3ead6" />
      <path d="M342 206 C342 194 347 184 351 178 C355 184 360 194 360 206 L360 332 L342 332 Z" fill="#f3ead6" />
      <rect x="280" y="198" width="18" height="134" fill="url(#ha-cyl)" stroke="none" />
      <rect x="342" y="198" width="18" height="134" fill="url(#ha-cyl)" stroke="none" />
      <line x1="280" y1="300" x2="298" y2="300" stroke-width="2.5" />
      <line x1="342" y1="300" x2="360" y2="300" stroke-width="2.5" />
      <path d="M282 332 L296 332 L299 344 L279 344 Z" fill="#1c130b" />
      <path d="M344 332 L358 332 L361 344 L341 344 Z" fill="#1c130b" />
      <!-- 第1段（オレンジの断熱材） -->
      <rect x="300" y="134" width="40" height="198" fill="#e8772e" />
      <rect x="300" y="134" width="40" height="198" fill="url(#ha-cyl)" stroke="none" />
      <line x1="300" y1="186" x2="340" y2="186" stroke-width="2" opacity="0.6" />
      <line x1="300" y1="262" x2="340" y2="262" stroke-width="2" opacity="0.6" />
      <text x="0" y="0" transform="translate(324 200) rotate(90)" font-family="Anton, sans-serif" font-size="15" letter-spacing="3" fill="#1c130b" stroke="none">JAPAN</text>
      <!-- 段間と第2段 -->
      <rect x="300" y="122" width="40" height="12" fill="#1c130b" />
      <rect x="300" y="80" width="40" height="42" fill="#f3ead6" />
      <rect x="300" y="80" width="40" height="42" fill="url(#ha-cyl)" stroke="none" />
      <!-- フェアリング（衛星を包む先端） -->
      <path d="M300 80 C300 48 310 24 320 10 C330 24 340 48 340 80 Z" fill="#f3ead6" />
      <path d="M300 80 C300 48 310 24 320 10 C330 24 340 48 340 80 Z" fill="url(#ha-cyl)" stroke="none" />
      <line x1="320" y1="14" x2="320" y2="80" stroke-width="1.5" opacity="0.5" />
      <!-- エンジン -->
      <path d="M306 332 L334 332 L338 346 L302 346 Z" fill="#1c130b" />
      <!-- 発射時の煙（地面で左右に広がる） -->
      <g fill="#e9dcbf" stroke-width="3">
        <circle cx="238" cy="402" r="14" /><circle cx="402" cy="402" r="14" />
        <circle cx="262" cy="396" r="22" /><circle cx="378" cy="396" r="22" />
        <circle cx="290" cy="392" r="26" /><circle cx="350" cy="392" r="26" />
        <circle cx="320" cy="400" r="22" />
      </g>
    </g>
  </g>
</svg>
