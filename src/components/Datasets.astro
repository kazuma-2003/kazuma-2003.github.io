---
// 記事に添えるデータセットの枠（Zenodo）。ダウンロード、DOI、引用の案内を出す。
// ブログはペンネームで運営し、Zenodo の作成者（学術用の本名）は表示しない。
// 引用文も作成者名を含むため載せず、DOI のコピーと Zenodo の Citation 欄への案内にする。
import { getDataset, formatBytes } from '../zenodo';

interface Props { dois: string[] }
const { dois } = Astro.props;
const sets = await Promise.all(dois.map((d) => getDataset(d)));
const ext = (name: string) => (name.split('.').pop() ?? '').toUpperCase();
---
{sets.length > 0 && (
  <section class="datasets" aria-label="この記事のデータ">
    {sets.map((d) => (
      <div class="dataset">
        <div class="ds-head">
          <div class="label">DATASET ── ZENODO</div>
          <a class="doi-badge" href={d.doiUrl} target="_blank" rel="noopener"><span>DOI</span>{d.doi}</a>
        </div>
        <h2 class="ds-title">{d.title ?? 'この記事のデータ'}</h2>
        {d.ok && (
          <dl class="ds-meta">
            {d.date && <div><dt>公開日</dt><dd>{d.date.replaceAll('-', '.')}</dd></div>}
            {d.version && <div><dt>版</dt><dd>{d.version}</dd></div>}
            {d.license && <div><dt>使用条件</dt><dd>{d.license.url ? <a href={d.license.url} target="_blank" rel="noopener">{d.license.label}</a> : d.license.label}</dd></div>}
          </dl>
        )}
        {d.files && d.files.length > 0 ? (
          <ul class="ds-files">
            {d.files.map((f) => (
              <li>
                <a class="ds-file" href={f.url} rel="noopener">
                  <span class="ext">{ext(f.name)}</span>
                  <span class="fname">{f.name}</span>
                  <span class="fsize">{formatBytes(f.size)}</span>
                  <span class="dl">ダウンロード ↓</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="ds-fallback"><a class="btn small" href={d.html} target="_blank" rel="noopener">Zenodo でデータを見る →</a></p>
        )}
        <div class="ds-cite">
          <div class="ds-cite-head"><span>引用するときは</span><button type="button" class="ds-copy" data-cite={d.doiUrl}>DOI をコピー</button></div>
          <p>DOI（{d.doiUrl}）を示してください。正式な引用の書き方（APA など各形式）は、Zenodo のページの「Citation」欄で確認できます。</p>
        </div>
        <a class="ds-more" href={d.html} target="_blank" rel="noopener">Zenodo のページで詳しく見る（すべての版・説明） →</a>
      </div>
    ))}
  </section>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('.ds-copy').forEach((b) => b.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(b.dataset.cite ?? '');
      const t = b.textContent;
      b.textContent = 'コピーしました';
      setTimeout(() => { b.textContent = t; }, 2000);
    } catch {
      window.prompt('この DOI をコピーしてください', b.dataset.cite ?? '');
    }
  }));
</script>
